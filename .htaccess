<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Force remove /public/ or /sorolata/ from browser address bar
    RewriteCond %{THE_REQUEST} \s/+(public|sorolata)/?([^\s?]*) [NC]
    RewriteRule ^ /%2 [R=301,L]

    # 2. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Transparently rewrite to public/ folder internally without changing URL
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
